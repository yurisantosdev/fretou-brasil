{
  "name": "fretou-brasil",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.7",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11.0.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@fretou/clients": "^0.1.0",
    "@fretou/components": "^0.1.0",
    "@fretou/trips": "^0.1.0",
    "@fretou/users": "^0.1.0",
    "@phosphor-icons/react": "^2.1.10",
    "react-toastify": "^11.1.0"
  }
}
